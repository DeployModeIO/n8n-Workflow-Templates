{
  "name": "IA - Generador de Contenido para Redes",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "days", "daysInterval": 1 }] },
        "options": {}
      },
      "id": "sched-001",
      "name": "Cada Dia",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-240, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "t1", "name": "tema", "value": "productividad y automatizacion", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "set-tema-001",
      "name": "Definir Tema",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-20, 0]
    },
    {
      "parameters": {
        "method": "POST",
