        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"messages\": [\n    {\"role\": \"system\", \"content\": \"Eres un community manager. Genera un post atractivo para redes sociales con emojis y hashtags.\"},\n    {\"role\": \"user\", \"content\": \"Escribe un post sobre: {{ $json.tema }}\"}\n  ]\n}",
        "options": {}
      },
      "id": "http-gen-001",
      "name": "Generar Post IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "chatId": "TU_CHAT_ID",
        "text": "=📝 Post del dia:\n\n{{ $json.choices[0].message.content }}",
        "additionalFields": {}
      },
      "id": "tg-001",
      "name": "Enviar a Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [460, 0]
    }
  ],
  "connections": {
    "Cada Dia": { "main": [[{ "node": "Definir Tema", "type": "main", "index": 0 }]] },
    "Definir Tema": { "main": [[{ "node": "Generar Post IA", "type": "main", "index": 0 }]] },
    "Generar Post IA": { "main": [[{ "node": "Enviar a Telegram", "type": "main", "index": 0 }]] }
