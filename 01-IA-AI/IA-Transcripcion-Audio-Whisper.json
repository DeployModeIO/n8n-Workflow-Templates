{
  "name": "IA - Transcripcion de Audio (Whisper)",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "transcribir", "responseMode": "responseNode", "options": {} },
      "id": "wh-wsp-001",
      "name": "Webhook Audio",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-220, 0],
      "webhookId": "transcribir"
    },
    {
      "parameters": {
        "url": "={{ $json.body.url_audio }}",
        "options": { "response": { "response": { "responseFormat": "file" } } }
