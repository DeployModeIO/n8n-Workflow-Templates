        "contentType": "multipart-form-data",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "whisper-1" },
            { "name": "language", "value": "es" },
            { "parameterType": "n8nBinaryFile", "name": "file", "inputDataFieldName": "data" }
          ]
        },
        "options": {}
      },
      "id": "http-wsp-001",
      "name": "Whisper API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"transcripcion\": {{ JSON.stringify($json.text) }}\n}",
        "options": {}
      },
      "id": "resp-wsp-001",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [440, 0]
    }
  ],
  "connections": {
    "Webhook Audio": { "main": [[{ "node": "Descargar Audio", "type": "main", "index": 0 }]] },
    "Descargar Audio": { "main": [[{ "node": "Whisper API", "type": "main", "index": 0 }]] },
    "Whisper API": { "main": [[{ "node": "Responder", "type": "main", "index": 0 }]] }
  },
