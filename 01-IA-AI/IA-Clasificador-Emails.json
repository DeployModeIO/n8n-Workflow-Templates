{
  "name": "IA - Clasificador de Emails con IA",
  "nodes": [
    {
      "parameters": {
        "pollTimes": { "item": [{ "mode": "everyMinute" }] },
        "filters": {},
        "options": {}
      },
      "id": "gmail-trg-001",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [-240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"messages\": [\n    {\"role\": \"system\", \"content\": \"Clasifica el email en una sola categoria: urgente, normal, spam, newsletter. Responde SOLO con la categoria.\"},\n    {\"role\": \"user\", \"content\": \"Asunto: {{ $json.subject }}\\n\\n{{ $json.textPlain || $json.snippet }}\"}\n  ]\n}",
        "options": {}
      },
      "id": "http-clasif-001",
      "name": "Clasificar IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "asunto", "value": "={{ $('Gmail Trigger').item.json.subject }}", "type": "string" },
            { "id": "a2", "name": "categoria", "value": "={{ $json.choices[0].message.content.trim().toLowerCase() }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "set-001",
      "name": "Preparar Datos",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.categoria }}", "rightValue": "urgente", "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-001",
      "name": "Es Urgente?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 0]
    },
    {
      "parameters": { "chatId": "TU_CHAT_ID", "text": "=🚨 EMAIL URGENTE\nAsunto: {{ $json.asunto }}", "additionalFields": {} },
      "id": "tg-urg-001",
      "name": "Alertar Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [720, -100]
    },
    {
      "parameters": { "values": { "string": [{ "name": "estado", "value": "archivado" }] }, "options": {} },
      "id": "noop-001",
      "name": "Archivar Normal",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [720, 120]
    }
  ],
  "connections": {
    "Gmail Trigger": { "main": [[{ "node": "Clasificar IA", "type": "main", "index": 0 }]] },
    "Clasificar IA": { "main": [[{ "node": "Preparar Datos", "type": "main", "index": 0 }]] },
    "Preparar Datos": { "main": [[{ "node": "Es Urgente?", "type": "main", "index": 0 }]] },
    "Es Urgente?": {
      "main": [
        [{ "node": "Alertar Telegram", "type": "main", "index": 0 }],
        [{ "node": "Archivar Normal", "type": "main", "index": 0 }]
      ]
    }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1" },
  "active": false,
  "tags": []
}