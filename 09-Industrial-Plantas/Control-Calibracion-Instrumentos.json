    { "parameters": { "jsCode": "// Detecta instrumentos con calibracion vencida o por vencer (<=15 dias)\nconst hoy = new Date();\nconst out = [];\nfor (const it of $input.all()) {\n  const v = new Date(it.json.proxima_calibracion);\n  const dias = Math.round((v - hoy) / 86400000);\n  if (dias <= 15) out.push({ json: { tag: it.json.tag, descripcion: it.json.descripcion, area: it.json.area, dias, vencido: dias < 0 } });\n}\nreturn out.length ? out : [{ json: { ninguno: true } }];" }, "id": "cal-code", "name": "Filtrar Vencimientos", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [160, 0] },
    { "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" }, "conditions": [ { "id": "c1", "leftValue": "={{ $json.ninguno }}", "rightValue": true, "operator": { "type": "boolean", "operation": "notTrue" } } ], "combinator": "and" }, "options": {} }, "id": "cal-if", "name": "Hay Vencimientos?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [400, 0] },
