{
  "name": "Industrial - Alarmas SCADA a Sala de Control",
  "nodes": [
    { "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 1 }] }, "options": {} }, "id": "sc-sched", "name": "Lectura SCADA", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [-320, 0] },
    { "parameters": { "method": "GET", "url": "http://OPC-SERVER/api/tags?lista=criticos", "authentication": "predefinedCredentialType", "nodeCredentialType": "httpHeaderAuth", "options": {} }, "id": "sc-read", "name": "Leer Tags OPC/Modbus", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [-80, 0] },
    { "parameters": { "jsCode": "// Evalua cada tag contra limites de ingenieria (HH/H/L/LL)\nconst tags = $input.first().json.tags || [];\nconst alarmas = [];\nfor (const t of tags) {\n  let lvl = null;\n  if (t.valor >= t.HH) lvl = 'ALTA-ALTA';\n  else if (t.valor >= t.H) lvl = 'ALTA';\n  else if (t.valor <= t.LL) lvl = 'BAJA-BAJA';\n  else if (t.valor <= t.L) lvl = 'BAJA';\n  if (lvl) alarmas.push({ tag: t.tag, valor: t.valor, unidad: t.unidad, nivel: lvl, area: t.area });\n}\nreturn alarmas.length ? alarmas.map(a => ({ json: a })) : [{ json: { sinAlarmas: true } }];" }, "id": "sc-eval", "name": "Evaluar Alarmas", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [160, 0] },
    { "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" }, "conditions": [ { "id": "s1", "leftValue": "={{ $json.sinAlarmas }}", "rightValue": true, "operator": { "type": "boolean", "operation": "notTrue" } } ], "combinator": "and" }, "options": {} }, "id": "sc-if", "name": "Hay Alarma?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [400, 0] },
    { "parameters": { "operation": "append", "documentId": { "__rl": true, "mode": "id", "value": "TU_SPREADSHEET_ID" }, "sheetName": { "__rl": true, "mode": "name", "value": "HistorialAlarmas" }, "columns": { "mappingMode": "autoMapInputData", "value": {}, "matchingColumns": [] }, "options": {} }, "id": "sc-log", "name": "Registrar Historial", "type": "n8n-nodes-base.googleSheets", "typeVersion": 4.5, "position": [640, -160] },
    { "parameters": { "chatId": "TU_CHAT_ID", "text": "=🚨 ALARMA SCADA {{ $json.nivel }}\nTag: {{ $json.tag }} = {{ $json.valor }} {{ $json.unidad }}\nArea: {{ $json.area }}\nAccion requerida en sala de control", "additionalFields": {} }, "id": "sc-tg", "name": "Notificar Sala Control", "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [640, 80] }
  ],
